# --- Required ----------------------------------------------------------------
# IP address of your Homey Pro (preferably a fixed address via a DHCP reservation)
HOMEY_ADDRESS=http://192.168.1.50
# API key from the Homey web app: Settings > API Keys
# Leave empty to start the dashboard in demo mode (without a Homey)
HOMEY_TOKEN=

# PIN to open edit mode (empty = no PIN)
EDIT_PIN=1234

# --- Security (optional) -----------------------------------------------------
# Only allow access from these networks (comma-separated, IPv4 with /mask)
ALLOWED_NETWORKS=
# Log in with username and password (once per device, then remembered for a year)
DASH_USER=
DASH_PASS=
# Set to 1 when running behind a reverse proxy such as Traefik, so the tablet's real IP is used
TRUST_PROXY=1

# --- Integrations (optional) -------------------------------------------------
# Energy dashboard, for the "Energy today" tile and the "Overview" screensaver.
# If both containers share a Docker network, the container name works as the address.
ENERGY_URL=

# --- Storage (optional) ------------------------------------------------------
# Daily backup of the layout (path inside the container, mount it in docker-compose)
BACKUP_DIR=
# Folder with photos for the photo-frame screensaver (path inside the container)
PHOTOS_DIR=/app/photos
