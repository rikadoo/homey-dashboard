# --- Verplicht ---------------------------------------------------------------
# IP-adres van je Homey Pro (bij voorkeur een vast adres via een DHCP-reservering)
HOMEY_ADDRESS=http://192.168.1.50
# API-sleutel uit de Homey web-app: Instellingen > API-sleutels
# Laat leeg om het dashboard in demo-modus (zonder Homey) te starten
HOMEY_TOKEN=

# Pincode om de bewerkmodus te openen (leeg = geen pincode)
EDIT_PIN=1234

# --- Beveiliging (optioneel) -------------------------------------------------
# Alleen toegang vanaf deze netwerken (komma-gescheiden, IPv4 met /masker)
ALLOWED_NETWORKS=
# Inloggen met gebruikersnaam en wachtwoord (één keer per apparaat, daarna een jaar onthouden)
DASH_USER=
DASH_PASS=
# Zet op 1 als het dashboard achter Traefik draait, zodat het echte IP-adres van de tablet wordt gebruikt
TRUST_PROXY=1

# --- Koppelingen (optioneel) -------------------------------------------------
# Je energiedashboard, voor de tegel "Energie vandaag" en de schermbeveiliging "Overzicht".
# Beide containers zitten in het netwerk traefik_default, dus de containernaam werkt als adres.
ENERGY_URL=http://energie-dashboard:8080

# --- Opslag (optioneel) ------------------------------------------------------
# Dagelijkse back-up van de indeling (pad in de container, koppel het in docker-compose)
BACKUP_DIR=
# Map met foto's voor de schermbeveiliging (pad in de container)
PHOTOS_DIR=/app/photos
